# Phase 1 runs on device without environment variables.
# Configure future external provider credentials only on the server.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# FASHN_API_KEY=

# Optional ADPICK Business search, server only, after provider approval.
# ADPICK_SHOPPING_ENABLED=false
# ADPICK_API_KEY=
# MET Norway public forecasts require no key.
